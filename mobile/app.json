{
  "expo": {
    "name": "SleepSense",
    "slug": "sleepsense",
    "version": "1.0.0",
    "scheme": [
      "sleepsense",
      "com.googleusercontent.apps.1035358190251-l2apra3gh2j62h8d6opogtiubekgnv90"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0B1F"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B1F"
      },
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.sleepsense"
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SleepSense needs microphone access to record your sleep audio.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "./plugins/withAndroidForegroundAudio",
      "react-native-fast-tflite",
      "expo-web-browser",
      [
        "@siteed/audio-studio",
        {
          "microphonePermission": "Allow SleepSense to access your microphone to record sleep audio."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SleepSense to access your microphone to record sleep audio."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#A78BFA",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "authUrl": "https://momentum-needle-initiated-farm.trycloudflare.com",
      "analyticsUrl": "https://statistics-warnings-velocity-narrow.trycloudflare.com",
      "ingestionUrl": "https://opens-land-relatives-olympus.trycloudflare.com",
      "eas": {
        "projectId": "2e66d995-e13b-4d68-be36-dcf501631d9d"
      }
    },
    "owner": "aman196agrawal"
  }
}
