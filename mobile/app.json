{
  "expo": {
    "name": "SleepSense",
    "slug": "sleepsense-demo",
    "version": "1.0.0",
    "scheme": [
      "sleepsense",
      "com.googleusercontent.apps.1035358190251-l2apra3gh2j62h8d6opogtiubekgnv90"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0B0B1F"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B1F"
      },
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.anonymous.sleepsense"
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SleepSense needs microphone access to record your sleep audio.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "./plugins/withAndroidForegroundAudio",
      "react-native-fast-tflite",
      "expo-web-browser",
      [
        "@siteed/audio-studio",
        {
          "microphonePermission": "Allow SleepSense to access your microphone to record sleep audio."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SleepSense to access your microphone to record sleep audio."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#A78BFA",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "authUrl": "http://192.168.1.15:8001",
      "analyticsUrl": "http://192.168.1.15:8002",
      "ingestionUrl": "https://realm-spiritual-screenshots-immunology.trycloudflare.com",
      "eas": {
        "projectId": "3199a274-0b2d-4ba3-ac49-cf0b6f81d30f"
      }
    },
    "owner": "aman_narayan"
  }
}
