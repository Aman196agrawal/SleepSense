# Google OAuth client IDs — copy this file to `.env` once you have real values.
# Expo reads EXPO_PUBLIC_* vars at bundle time. Restart `expo start` after editing.
#
# Get these from Google Cloud Console → APIs & Services → Credentials.
#   WEB    : the "Web application" OAuth client ID (also used by the backend to
#            validate the id_token audience — set GOOGLE_CLIENT_ID to the SAME value)
#   ANDROID: the "Android" OAuth client ID (package com.anonymous.sleepsense + SHA-1)
#   IOS    : the "iOS" OAuth client ID (bundle id), optional if Android-only
#
# Leave a line blank/removed if you don't have that platform's client yet.

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
