  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "credentialsSource": "local",
      "cache": {
        "disabled": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
