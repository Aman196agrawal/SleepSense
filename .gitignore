# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Claude Code local settings (contains dev secrets and local paths)
.claude/settings.local.json

# EAS local credentials (keystore passwords — never commit)
mobile/credentials.json

# Docker volumes / logs
*.log
logs/

# SQLite dev databases (contain hashed passwords, refresh tokens, seeded data)
services/*/data/*.db
services/*/data/*.db-journal
services/*/data/*.db-wal
services/*/data/*.db-shm
# Timestamped backups of the same DBs — same sensitive contents, so ignore too
services/*/data/*.bak_*
services/*/data/*.db.bak*

# ML artifacts — trained weights are not committed (use EAS secrets / S3 for the real model)
*.pt
*.pth
*.onnx
*.tflite
# Exception: the 8-byte placeholder stub that Metro needs at bundle time
!mobile/assets/models/snore_classifier.tflite
mlruns/

# Screenshots (large binary, optional — remove line to include)
# mobile/screenshots/
/tools/

# Personal sleep/snore audio captures — private data, hundreds of MB
Recordings/

# Built APKs (regenerate with build_apk_release.bat) and build diagnostics
*.apk
eas_phase.ndjson
gradle_diag.bat

# Local demo/preview scratch output — not referenced by the app or docs
mobile/demo/
